{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 65
    }
  },
  "crons": [
    {
      "path": "/cron/tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/cron/nightly",
      "schedule": "0 3 * * *"
    }
  ]
}
